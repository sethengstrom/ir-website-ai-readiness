// IR AI Readiness Scanner - Prisma schema
// Use SQLite for local; switch DATABASE_URL to Postgres for deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScanRun {
  id        String   @id @default(cuid())
  domainA   String
  domainB   String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  status    String   // "running" | "completed" | "failed"
  resultA   String?  // JSON string of DomainResult
  resultB   String?  // JSON string of DomainResult
}
